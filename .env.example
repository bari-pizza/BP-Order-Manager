# Environment Variables

# Supabase Configuration
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Required for Playwright seed (creates test users + wipes today's orders). Never prefix with VITE_.
# Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to testtest (Supabase requires 6+ characters; "test" is too short).
# TEST_ACCOUNT_PASSWORD=testtest

# Optional overrides. Seed creates these if unset:
#   test.admin@gmail.com (manager)
#   test.driver1@gmail.com
#   test.driver2@gmail.com
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_DRIVER_EMAIL=

# Sentry Error Monitoring (Production Only)
# Sign up at https://sentry.io and create a React project
# Get your DSN from: Settings -> Projects -> [Your Project] -> Client Keys (DSN)
# Leave empty in development - Sentry will only run in production builds
VITE_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/7654321

# Optional: Google Maps API Key (currently not used but prepared for future)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# VITE_ prefix is only required for values the browser bundle needs (Vite).
# SUPABASE_SERVICE_ROLE_KEY and TEST_* are Node/Playwright-only — do not prefix those with VITE_.
